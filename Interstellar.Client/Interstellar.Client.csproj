<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Interstellar</RootNamespace>
    <AssemblyName>Interstellar.Client</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <!-- ================================================================
       Among Us / BepInEx plugin framework (compile only, not embedded)
       ================================================================ -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2025.10.14" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- ================================================================
       Voice chat dependencies — resolved by NuGet at build time.
       At runtime (Among Us IL2CPP) they are loaded from embedded
       resources by the AssemblyResolve handler.
       ================================================================ -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <!-- ================================================================
       Embedded resources: sprites + locale JSONs
       ================================================================ -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <EmbeddedResource Include="Resources\Logo.jpg" />
    <EmbeddedResource Include="Resources\stringData.json" />
  </ItemGroup>

  <!-- ================================================================
       Embedded dependency DLLs — NAudio + Concentus only.
       Embedded directly from NuGet reference assemblies in a single
       build pass, so no Libs/ folder and no two-pass build are needed.
       ================================================================ -->
  <Target Name="StageEmbeddedLibraries" BeforeTargets="SplitResourcesByCulture" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_EmbeddedLib Include="@(ReferenceCopyLocalPaths)"
                    Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'NAudio'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Core'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Asio'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Midi'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Wasapi'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.WinMM'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'Concentus'" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="@(_EmbeddedLib)">
        <LogicalName>Lib.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
